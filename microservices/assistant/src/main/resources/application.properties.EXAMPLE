server.port=8090

# Spring AI Properties 1.0.3, see https://docs.spring.io/spring-ai/reference/api/chat/anthropic-chat.html
spring.ai.enabled=true
spring.ai.model.chat=anthropic
spring.ai.anthropic.api-key=${ANTHROPIC_API_KEY}
spring.ai.anthropic.chat.options.model=claude-sonnet-5-5
spring.ai.anthropic.chat.options.max-tokens=4096
