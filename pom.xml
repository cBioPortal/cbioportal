<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
  </parent>

  <!-- Parent and aggregator for the web application (web/, artifact io.github.cbioportal:cbioportal),
       the importer (importer/) and the types both use (shared-model/). Every dependency version is
       declared here, once. -->
  <groupId>io.github.cbioportal</groupId>
  <artifactId>cbioportal-parent</artifactId>
  <version>v7.2.5-SNAPSHOT</version>
  <packaging>pom</packaging>
  <description>cBioPortal for Cancer Genomics: parent POM</description>

  <modules>
    <module>shared-model</module>
    <module>web</module>
    <module>importer</module>
  </modules>

  <properties>
    <m2e.apt.activation>jdt_apt</m2e.apt.activation>
    <!-- <maven.compiler.release>21</maven.compiler.release>-->
    <sonar.java.source>21</sonar.java.source>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
    <timestamp>${maven.build.timestamp}</timestamp>
    <!-- TODO replace with version of cbioportal frontend with compatible login url-->
    <frontend.groupId>io.github.cbioportal</frontend.groupId>
    <frontend.artifactId>frontend-cbioportal</frontend.artifactId>
    <frontend.version>v7.2.4</frontend.version>
    <!-- THIS SHOULD BE KEPT IN SYNC WITH src/main/resources/db-scripts/clickhouse/init/schema.sql
         AND src/main/resources/db-scripts/clickhouse/migrate/migrate_schema.sql -->
    <db.version>3.1.0</db.version>

    <!-- Version properties for dependencies that should have same version. -->
    <!-- The rest can be set in the dependencyManagement section -->
    <spring.social.version>1.1.6.RELEASE</spring.social.version>

    <mysql-connector.version>8.0.28</mysql-connector.version>
    <mysql.version>8.2.0</mysql.version>
    <springfox.version>3.0.0</springfox.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Sonar -->
    <sonar.projectKey>cBioPortal_cbioportal</sonar.projectKey>
    <sonar.moduleKey>${project.groupId}:${project.artifactId}</sonar.moduleKey>
    <sonar.organization>cbioportal</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.coverage.exclusions>**src/test/**/*.*</sonar.coverage.exclusions>

    <!-- JaCoCo Properties -->
    <jacoco.version>0.8.11</jacoco.version>
    <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
    <sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
    <sonar.language>java</sonar.language>
    <sonar.coverage.jacoco.xmlReportPaths>
      ${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

    <db.test.driver>com.mysql.jdbc.Driver</db.test.driver>
    <!-- For MySQL < 5.5 change 'default_storage_engine' to 'storage_engine' -->
    <db.test.url>
      jdbc:mysql://127.0.0.1:3306/cgds_test?sessionVariables=default_storage_engine=InnoDB&amp;allowLoadLocalInfile=true</db.test.url>
    <db.test.username>cbio_user</db.test.username>
    <db.test.password>somepassword</db.test.password>

    <!--For
    tomcat instances, the scope to tomcat catalina lib should be provided. this prop is used in
    portal module.-->
    <tomcat.catalina.scope>provided</tomcat.catalina.scope>
    <tomcat.session.timeout>720</tomcat.session.timeout>

    <!-- Unknown -->
    <io.swagger.version>1.6.3</io.swagger.version>
    <mybatis.starter.version>4.1.0</mybatis.starter.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <opensaml.version>4.3.2</opensaml.version>

    <!-- Third Party -->
    <redisson.version>4.7.0</redisson.version>
    <commons-math3.version>3.6.1</commons-math3.version>
    <springdoc.version>3.0.0</springdoc.version>
    <apache-commons-collections.version>4.4</apache-commons-collections.version>
    <io-jsonwebtoken.version>0.11.2</io-jsonwebtoken.version>
    <mongodb_bson.version>4.11.0</mongodb_bson.version>
    <google_guava.version>32.1.3-jre</google_guava.version>
    <commons_codec.version>1.16.0</commons_codec.version>
    <commons_validator.version>1.10.0</commons_validator.version>
    <simple_java_bitly.version>1.1</simple_java_bitly.version>
    <ehcache.version>3.7.1</ehcache.version>
    <json_simple.version>1.1.1</json_simple.version>
    <mongo_java_driver.version>3.12.14</mongo_java_driver.version>
    <datumbox.version>0.8.2</datumbox.version>
    <selenium_chrome_driver.version>3.14.0</selenium_chrome_driver.version>
    <selenium.version>4.31.0</selenium.version>
    <!-- 0.6.4 breaks 21 ClickHouse mapper tests (empty clinical data counts and resource
         metadata stats); stay on 0.6.2 until the cause is found. See the RFC's
         "Upgrade the ClickHouse JDBC driver" section. -->
    <clickhouse_jdbc.version>0.6.2</clickhouse_jdbc.version>
    <!-- 1.85 clears CVE-2026-8763 (critical) and CVE-2026-13506 (high) -->
    <bouncy_castle.version>1.85</bouncy_castle.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <!-- Importer-only dependencies -->
    <maf.version>1.0.0</maf.version>
    <lz4.version>1.8.0</lz4.version>
    <easymock.version>4.3</easymock.version>
    <junitparams.version>1.1.0</junitparams.version>
    <!-- CVE fixes ahead of the Spring Boot BOM: Boot 4.1.0 manages Tomcat 11.0.22, which is
         flagged for CVE-2026-65182 (important), CVE-2026-65905 and CVE-2026-68525, all fixed
         in 11.0.25. Stay on the 11.0.x line Boot 4 is built against. -->
    <tomcat.version>11.0.27</tomcat.version>
    <!-- CVE fixes ahead of the Spring Boot BOM: netty 4.1.135 (managed by Boot
         3.5.16) misses the Bzip2Decoder event-loop hang (GHSA-558v-64gr-wgg4),
         and jackson 2.21.4 is flagged for two @JsonView bypasses fixed in
         2.21.5 (CVE-2026-59889, GHSA-mhm7-754m-9p8w). 4.1.137.Final further
         clears CVE-2026-75595 (critical) / CVE-2026-75596 (medium) -->
    <netty.version>4.1.137.Final</netty.version>
    <!-- jackson-bom.version (the old override point) is now Boot's own property for the
         *new* tools.jackson:jackson-bom coordinate (Jackson 3); pinning it to a Jackson-2
         version here breaks BOM resolution outright. Boot 4 exposes the legacy Jackson 2
         line as a separate jackson-2-bom.version property instead (default 2.21.4), which
         still needs the same CVE-2026-59889 / GHSA-mhm7-754m-9p8w override as above. -->
    <jackson-2-bom.version>2.21.6</jackson-2-bom.version>
    <velocity.version>2.4</velocity.version>
    <!-- Override the Spring Boot BOM (httpcore5 5.3.x): httpcore5 < 5.4.3 is flagged
         by GHSA-hf6x-8p5f-cgmf / GHSA-v3jc-474w-2wm6; 5.6.x is the httpclient5 line
         built against httpcore5 5.4.x -->
    <httpclient5.version>5.6.4</httpclient5.version>
    <httpcore5.version>5.4.3</httpcore5.version>
    <!-- CVE fixes ahead of the Spring Boot BOM (log4j 2.24.3, commons-lang3 3.17.0):
         log4j-api < 2.25.5 and commons-lang3 < 3.18.0 are flagged as medium -->
    <log4j2.version>2.25.5</log4j2.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>

    <!-- No sure what these are for -->
    <bundle.symbolicName.prefix>org.mskcc</bundle.symbolicName.prefix>
    <bundle.namespace>org.mskcc.mondrian</bundle.namespace>

    <!-- Maven Central -->
    <mavenCentralDeploymentName>Deployment</mavenCentralDeploymentName>

    <skipIntegrationTests>true</skipIntegrationTests>
    <skipE2ETests>True</skipE2ETests>
  </properties>

  <!-- Maven Central Requirements -->
  <name>${project.groupId}:${project.artifactId}</name>
  <url>https://www.cbioportal.org</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Zain Nasir</name>
      <email>nasirz1@mskcc.org</email>
      <organization>Memorial Sloan Kettering Cancer Center</organization>
      <organizationUrl>https://www.mskcc.org/</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/cBioPortal/cbioportal.git</connection>
    <developerConnection>scm:git:ssh://github.com:cBioPortal/cbioportal.git</developerConnection>
    <url>https://github.com/cBioPortal/cbioportal/tree/master</url>
  </scm>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>${bouncy_castle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncy_castle.version}</version>
      </dependency>
      <!-- set newer versions of velocity to prevent pulling in old commons-io version that has vulnerabilities -->
      <dependency>
        <groupId>org.apache.velocity</groupId>
        <artifactId>velocity-engine-core</artifactId>
        <version>${velocity.version}</version>
      </dependency>
      <!-- Shared by the web application and the importer -->
      <dependency>
        <groupId>io.github.cbioportal</groupId>
        <artifactId>shared-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.clickhouse</groupId>
        <artifactId>clickhouse-jdbc</artifactId>
        <version>${clickhouse_jdbc.version}</version>
        <!-- the "http" classifier does not shade Apache HttpClient (the "all" uber jar
        bundles a vulnerable httpcore5 that Maven cannot override); the HTTP transport
        is supplied by the explicit httpclient5 dependency instead -->
        <classifier>http</classifier>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${google_guava.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-collections4</artifactId>
        <version>${apache-commons-collections.version}</version>
      </dependency>
      <dependency>
        <groupId>pl.pragmatists</groupId>
        <artifactId>JUnitParams</artifactId>
        <version>${junitparams.version}</version>
      </dependency>
      <!-- Importer-only -->
      <dependency>
        <groupId>io.github.cbioportal</groupId>
        <artifactId>maf</artifactId>
        <version>${maf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lz4.version}</version>
      </dependency>
      <dependency>
        <groupId>org.easymock</groupId>
        <artifactId>easymock</artifactId>
        <version>${easymock.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-wrapper-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-wrapper-plugin</artifactId>
        <inherited>false</inherited>
      </plugin>
      <!-- Configuration for code formatting -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.44.3</version>
        <!-- Root only: the include paths below are relative to the repository root -->
        <inherited>false</inherited>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include> <!-- Check application code -->
              <include>src/test/java/**/*.java</include> <!-- Check application tests code -->
              <include>shared-model/src/main/java/**/*.java</include> <!-- Check shared types -->
            </includes>
            <googleJavaFormat>
              <version>1.25.2</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <importOrder /> <!-- standard import order -->
            <removeUnusedImports /> <!-- self-explanatory -->
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Setup spotless formatter pre-commit hoot -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <!-- Run the shell script to modify the pre-commit hook -->
                <exec executable="bash">
                  <arg value="${project.basedir}/.githooks/spotless_pre_commit_hook.sh" />
                </exec>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <pluginRepositories>
    <pluginRepository>
      <id>maven-snapshots</id>
      <url>https://repository.apache.org/content/repositories/snapshots/</url>
    </pluginRepository>
    <pluginRepository>
      <id>maven-shade-plugin</id>
      <url>
        https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-shade-plugin</url>
    </pluginRepository>
  </pluginRepositories>

  <repositories>
    <!-- needed for the opensaml dependency (Shibboleth migrated from Nexus to this URL) -->
    <repository>
      <id>shiboleth</id>
      <url>https://build.shibboleth.net/maven/releases/</url>
    </repository>
    <!-- needed for keycloak test containers -->
    <repository>
      <id>maven-central</id>
      <url>https://repo1.maven.org/maven2/</url>
    </repository>
  </repositories>

  <profiles>
    <profile>
      <id>default</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <skipTests>false</skipTests>
        <!-- skipITs is an official Maven param; do not rename-->
        <skipITs>true</skipITs>
      </properties>
    </profile>
    <profile>
      <id>integration-test</id>
      <properties>
        <skipTests>true</skipTests>
        <!-- skipITs is an official Maven param; do not rename-->
        <skipIntegrationTests>false</skipIntegrationTests>
        <skipE2ETests>false</skipE2ETests>
      </properties>
    </profile>
    <profile>
      <id>e2e-test</id>
      <properties>
        <skipTests>true</skipTests>
        <!-- skipITs is an official Maven param; do not rename-->
        <skipIntegrationTests>true</skipIntegrationTests>
        <skipE2ETests>false</skipE2ETests>
      </properties>
    </profile>
    <profile>
      <id>third-party-report</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>license-maven-plugin</artifactId>
            <version>2.7.1</version>
            <configuration>
              <addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
              <includedScopes>compile,runtime</includedScopes>
              <includeOptional>true</includeOptional>
              <includeTransitiveDependencies>true</includeTransitiveDependencies>
              <outputDirectory>
                ${project.build.directory}/generated-resources/licenses</outputDirectory>
              <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.3</version>
            <configuration>
              <projectType>application</projectType>
              <schemaVersion>1.6</schemaVersion>
              <includeBomSerialNumber>false</includeBomSerialNumber>
              <includeCompileScope>true</includeCompileScope>
              <includeProvidedScope>false</includeProvidedScope>
              <includeRuntimeScope>true</includeRuntimeScope>
              <includeSystemScope>false</includeSystemScope>
              <includeTestScope>false</includeTestScope>
              <includeLicenseText>false</includeLicenseText>
              <outputTimestamp>1970-01-01T00:00:00Z</outputTimestamp>
              <outputFormat>json</outputFormat>
              <outputName>bom</outputName>
              <outputDirectory>
                ${project.build.directory}/generated-resources/sbom</outputDirectory>
              <skipAttach>true</skipAttach>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Maven Central -->
    <profile>
      <id>maven-central</id>
      <activation>
        <property>
          <name>mavenCentral</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <deploymentName>${mavenCentralDeploymentName}</deploymentName>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>verify</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>attach-javadoc</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <stylesheet>java</stylesheet>
              <doclint>none</doclint>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
